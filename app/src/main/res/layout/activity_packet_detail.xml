<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_header_gradient"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/primary"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:textColor="@color/text"
                android:textSize="11sp"
                android:lineSpacingExtra="3dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/btnSendTg"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@drawable/bg_btn_primary"
                android:textColor="#0A0D12"
                android:text="TG"
                android:textSize="12sp"
                android:textStyle="bold"
                android:stateListAnimator="@null"/>

            <Button
                android:id="@+id/btnSave"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_btn_success"
                android:textColor="#0A0D12"
                android:text="SAVE"
                android:textSize="12sp"
                android:textStyle="bold"
                android:stateListAnimator="@null"/>

            <Button
                android:id="@+id/btnCopy"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_btn_accent"
                android:textColor="#0A0D12"
                android:text="COPY"
                android:textSize="12sp"
                android:textStyle="bold"
                android:stateListAnimator="@null"/>

            <Button
                android:id="@+id/btnShare"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_btn_danger"
                android:textColor="#0A0D12"
                android:text="SHARE"
                android:textSize="11sp"
                android:textStyle="bold"
                android:stateListAnimator="@null"/>
        </LinearLayout>

        <!-- HEX Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="12dp"
            android:layout_marginTop="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▌ HEX"
                android:textColor="@color/accent"
                android:textStyle="bold"
                android:textSize="12sp"
                android:letterSpacing="0.1"/>

            <TextView
                android:id="@+id/tvHex"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:fontFamily="monospace"
                android:textColor="#86EFAC"
                android:textSize="11sp"
                android:lineSpacingExtra="2dp"
                android:textIsSelectable="true"/>
        </LinearLayout>

        <!-- Decrypted -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="12dp"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▌ DECRYPTED"
                android:textColor="@color/accent"
                android:textStyle="bold"
                android:textSize="12sp"
                android:letterSpacing="0.1"/>

            <TextView
                android:id="@+id/tvDecrypted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:fontFamily="monospace"
                android:textColor="#FDE68A"
                android:textSize="11sp"
                android:lineSpacingExtra="2dp"
                android:textIsSelectable="true"/>
        </LinearLayout>

        <!-- Decoded -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="12dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▌ DECODED · PROTOBUF"
                android:textColor="@color/accent"
                android:textStyle="bold"
                android:textSize="12sp"
                android:letterSpacing="0.1"/>

            <TextView
                android:id="@+id/tvDecoded"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:fontFamily="monospace"
                android:textColor="@color/primary"
                android:textSize="11sp"
                android:lineSpacingExtra="2dp"
                android:textIsSelectable="true"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
