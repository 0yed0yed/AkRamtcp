<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/primary"
            android:textSize="20sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="6dp"
            android:paddingBottom="10dp"
            android:textColor="@color/text"
            android:textSize="12sp"/>

        <!-- Action buttons row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="12dp">

            <Button
                android:id="@+id/btnSendTg"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:backgroundTint="@color/primary"
                android:textColor="@color/bg"
                android:text="TG"
                android:textSize="12sp"
                android:textStyle="bold"/>

            <Button
                android:id="@+id/btnSave"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:backgroundTint="@color/success"
                android:textColor="@color/text_bright"
                android:text="SAVE"
                android:textSize="12sp"
                android:textStyle="bold"/>

            <Button
                android:id="@+id/btnCopy"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:backgroundTint="@color/accent"
                android:textColor="@color/bg"
                android:text="COPY"
                android:textSize="12sp"
                android:textStyle="bold"/>

            <Button
                android:id="@+id/btnShare"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:backgroundTint="@color/warning"
                android:textColor="@color/bg"
                android:text="SHARE"
                android:textSize="12sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- HEX -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="▌ HEX"
            android:textColor="@color/accent"
            android:textStyle="bold"
            android:textSize="13sp"/>

        <TextView
            android:id="@+id/tvHex"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface"
            android:padding="10dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:fontFamily="monospace"
            android:textColor="#8FBC8F"
            android:textSize="11sp"
            android:textIsSelectable="true"/>

        <!-- DECRYPTED -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="▌ DECRYPTED"
            android:textColor="@color/accent"
            android:textStyle="bold"
            android:textSize="13sp"/>

        <TextView
            android:id="@+id/tvDecrypted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface"
            android:padding="10dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:fontFamily="monospace"
            android:textColor="#FFD700"
            android:textSize="11sp"
            android:textIsSelectable="true"/>

        <!-- DECODED -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="▌ DECODED (PROTOBUF)"
            android:textColor="@color/accent"
            android:textStyle="bold"
            android:textSize="13sp"/>

        <TextView
            android:id="@+id/tvDecoded"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface"
            android:padding="10dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp"
            android:fontFamily="monospace"
            android:textColor="@color/primary"
            android:textSize="11sp"
            android:textIsSelectable="true"/>

    </LinearLayout>
</ScrollView>
