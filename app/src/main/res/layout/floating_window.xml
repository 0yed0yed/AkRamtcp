<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/floatRoot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_float_container"
        android:padding="10dp"
        android:elevation="8dp">

        <!-- Top row: dot + title + close -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:id="@+id/fDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="@color/text_dim"/>

            <TextView
                android:id="@+id/fTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="AkRam"
                android:textColor="@color/text_bright"
                android:textSize="11sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/fClose"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:gravity="center"
                android:text="✕"
                android:textColor="@color/danger"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/bg_float_close"/>
        </LinearLayout>

        <!-- Count -->
        <TextView
            android:id="@+id/fCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:text="0"
            android:textColor="@color/primary"
            android:textSize="26sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="packets"
            android:textColor="@color/text_dim"
            android:textSize="8sp"
            android:letterSpacing="0.1"/>

        <!-- Last packet -->
        <TextView
            android:id="@+id/fLast"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:text="—"
            android:textColor="@color/accent"
            android:textSize="9sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:gravity="center"
            android:background="@drawable/bg_float_last"
            android:padding="4dp"/>

        <!-- Mini action row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/fToggle"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="▶"
                android:textColor="#0A0D12"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/bg_float_btn_play"/>

            <TextView
                android:id="@+id/fOpen"
                android:layout_width="0dp"
                android:layout_height="28dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:gravity="center"
                android:text="📱"
                android:textSize="14sp"
                android:background="@drawable/bg_float_btn_open"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
